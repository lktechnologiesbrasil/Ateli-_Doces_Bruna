---
// SCENE 06 — O ATELIÊ. Material público real é limitado (nenhuma foto de
// fachada/interior em alta resolução disponível — ver pendência P3 do
// bloco 01 e TRACEABILITY.md). Usa o único fundo público que mostra o
// cenário assinatura da loja (letreiro "doces bruna" + flores), reaproveitado
// de PUB-026 com dois recortes (ambiente + detalhe), não uma foto de fachada.
import { Image } from 'astro:assets';
import ambiente from '../assets/photos/loja-ambiente.jpg';
---
<section class="atelier-bridge" aria-hidden="true">
  <p data-reveal>Tudo isso nasce em um lugar real.</p>
</section>

<section id="ateliê" class="atelier" data-scene="atelier" aria-label="O Ateliê">
  <div class="atelier__grid">
    <figure class="atelier__main" data-reveal>
      <Image
        src={ambiente}
        alt="Dentro do Ateliê: dois copos de sobremesa com o adesivo da marca, vitrine refrigerada e o letreiro 'doces bruna' com flores ao fundo"
        widths={[560, 900, 1280]}
        sizes="(max-width: 768px) 92vw, 50vw"
        width={1280}
        loading="lazy"
      />
    </figure>
    <figure class="atelier__detail" data-reveal>
      <Image
        src={ambiente}
        alt="Detalhe do letreiro 'doces bruna' com a flor da marca e o arranjo de flores na parede do Ateliê"
        widths={[900, 1280, 1600]}
        sizes="(max-width: 768px) 130vw, 50vw"
        width={1280}
        loading="lazy"
      />
    </figure>
    <div class="atelier__text" data-reveal>
      <h2>UM ATELIÊ<br />PARA CHAMAR<br />DE SEU.</h2>
      <p>Um espaço real, em Itapeva — Minas Gerais, com a marca na parede e os doces no balcão.</p>
    </div>
  </div>
</section>

<style>
  .atelier-bridge {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    padding: var(--space-xl) var(--container-gutter);
    text-align: center;
  }
  .atelier-bridge p {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-h2);
    max-width: 20ch;
    margin-inline: auto;
  }

  .atelier {
    background: var(--color-bg-inverse);
    color: var(--color-text-inverse);
    /* padding-top was 0: the photo grid sat flush against the section's own
       top edge with no inset (Impeccable detect, cramped-padding). */
    padding: var(--space-lg) var(--container-gutter) var(--space-2xl);
  }
  .atelier__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    grid-template-rows: auto auto;
    gap: var(--space-md);
    align-items: end;
  }
  .atelier__main {
    grid-column: 1;
    grid-row: 1 / 3;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 4 / 5;
  }
  .atelier__main :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: 70% 40%; }
  .atelier__detail {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    aspect-ratio: 1 / 1;
    transform: translateY(20%);
    position: relative;
  }
  /* Recorte real da foto de 4096px: quadrante superior direito (letreiro + flores),
     ~45% da largura/altura. Sem escala CSS sobre miniatura: a imagem é servida em ≥900px. */
  .atelier__detail :global(img) { position: absolute; width: 222%; height: 222%; max-width: none; left: -122%; top: 0; object-fit: cover; }
  .atelier__text { grid-column: 2; grid-row: 2; padding-block: var(--space-sm); }
  .atelier__text h2 { font-size: var(--text-h1); line-height: var(--leading-tight); margin-bottom: var(--space-sm); }
  .atelier__text p { font-size: var(--text-body-lg); max-width: 32ch; }

  @media (max-width: 768px) {
    .atelier-bridge { padding: var(--space-lg) var(--space-sm); }
    .atelier { padding: 0 var(--space-sm) var(--space-xl); }
    .atelier__grid { grid-template-columns: 1fr 1fr; }
    .atelier__main { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 5 / 4; }
    .atelier__detail { grid-row: 2; transform: none; }
    .atelier__text { grid-column: 1 / -1; grid-row: 3; padding-top: var(--space-sm); }
  }
</style>
