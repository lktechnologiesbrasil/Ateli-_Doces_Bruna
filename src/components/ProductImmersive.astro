---
// SCENE 04 — O PRODUTO OCUPA A TELA. HERO-C (PUB-017, caseirinho de
// chocolate) — melhor resolução para zoom (4096x4096), reservado para esta
// cena e não para o hero (ver justificativa do bloco 03: embalagem branca
// genérica reduz assinatura como abertura, mas funciona bem em close-up).
import { Image } from 'astro:assets';
import photo from '../assets/photos/hero-c-caseirinho.jpg';

// Frase da própria marca (legenda real de PUB-017, IG/p/DdSN0XJxESb/,
// 14/set/2026): "Nossos caseirinhos individuais são perfeitos para matar
// aquela vontade de um bolinho caseiro, fresquinho e feito com carinho." —
// substitui um slogan que não vinha de nenhuma fonte (Concept 01C, copy audit).
---
<section class="product" data-scene="produto" data-product-stage aria-label="Produto em destaque">
  <div class="product__frame" data-product-image>
    <Image
      src={photo}
      alt="Caseirinho de chocolate coberto de granulado, em close-up"
      widths={[900, 1280, 1800]}
      sizes="100vw"
      width={1800}
      height={1800}
      loading="lazy"
    />
  </div>
  <div class="product__scrim" aria-hidden="true"></div>
  <p class="product__word" data-reveal>Fresquinho, feito com carinho.</p>
</section>

<style>
  .product {
    position: relative;
    min-height: 100svh;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-cacao-deep);
  }
  .product__frame { position: absolute; inset: 0; will-change: transform; }
  .product__frame :global(img) { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }
  /* Scrim (not just text-shadow) so the headline holds WCAG AA contrast
     regardless of what part of the photo sits behind it (Impeccable
     detector flagged text-shadow-only contrast as unreliable here). */
  .product__scrim {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(79 48 25 / 0.72) 0%, rgb(79 48 25 / 0.45) 45%, rgb(79 48 25 / 0) 75%);
  }
  .product__word {
    position: relative;
    z-index: 1;
    font-family: var(--font-display);
    font-size: var(--text-h1);
    color: var(--color-text-inverse);
    padding: var(--space-sm) var(--space-md);
    text-align: center;
  }

  @media (max-width: 768px) {
    .product { min-height: 80svh; }
    .product__word { font-size: clamp(2rem, 8vw, 2.75rem); }
  }
</style>
