---
// SCENE 09 — VISITE O ATELIÊ. Horário e endereço completo divergem entre
// fontes públicas (Google, Instagram, Yooga — ver Docs/atelier-bruna/
// 08_SOURCES_AND_EVIDENCE.md) e o endereço segue marcado PARCIAL em
// 12_CONTENT_MATRIX.md: por decisão explícita do dono do projeto,
// nenhum horário ou endereço completo é exibido como fato definitivo
// nesta fase. Só a cidade (convergente entre todas as fontes) e um CTA
// de busca no Google Maps pelo nome da marca (sem coordenada fixada).
const mapsUrl = 'https://www.google.com/maps?cid=3062253418133205798'; // CID da ficha pública do Google (extraído da URL da própria ficha, set/2026)
---
<section id="visite" class="visit" data-scene="visite" aria-label="Visite o Ateliê">
  <h2 class="visit__place" data-reveal>ITAPEVA<br /><span>MINAS GERAIS</span></h2>
  <p class="visit__note" data-reveal>
    Confira os horários atualizados no Google Maps ou no WhatsApp antes de visitar.
  </p>
  <a class="btn btn-primary" href={mapsUrl} target="_blank" rel="noopener" data-reveal>Como chegar →</a>
</section>

<style>
  .visit {
    background: var(--color-bg);
    color: var(--color-text);
    min-height: 70svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: var(--space-sm);
    padding: var(--space-2xl) var(--space-sm);
  }
  .visit__place {
    font-size: clamp(3rem, 8vw, 6rem);
    line-height: var(--leading-tight);
  }
  .visit__place span {
    display: block;
    margin-top: var(--space-2xs);
    font-family: var(--font-body);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: 0.32em;
  }
  .visit__note { max-width: 40ch; font-size: var(--text-body); opacity: 0.85; margin-bottom: var(--space-sm); }
</style>
