---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import DetailScene from '../components/DetailScene.astro';
import ProductImmersive from '../components/ProductImmersive.astro';
import Creations from '../components/Creations.astro';
import AtelierScene from '../components/AtelierScene.astro';
import Gallery from '../components/Gallery.astro';
import OrderPaths from '../components/OrderPaths.astro';
import Visit from '../components/Visit.astro';
import Closing from '../components/Closing.astro';
import Footer from '../components/Footer.astro';
---
<Base
  title="Ateliê Doces Bruna — Concept 01"
  description="Protótipo local do site do Ateliê Doces Bruna, construído a partir de material público real da marca."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Manifesto />
    <DetailScene />
    <ProductImmersive />
    <Creations />
    <AtelierScene />
    <Gallery />
    <OrderPaths />
    <Visit />
    <Closing />
  </main>
  <Footer />
</Base>
