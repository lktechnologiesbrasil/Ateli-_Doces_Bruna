  description="Protótipo local do site do Ateliê Doces Bruna, construído a partir de material público real da marca."
>
  <Header />
  <main id="conteudo">
    <Hero />
    <Manifesto />
    <DetailScene />
    <ProductImmersive />
    <Creations />
    <ComingNext />
